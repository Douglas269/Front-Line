config_version=5

[application]

config/name="FrontLine Conquista"
run/main_scene="res://principal.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://arte/icone.png"
boot_splash/bg_color=Color(0.047, 0.059, 0.051, 1)

[display]

window/size/viewport_width=540
window/size/viewport_height=1170
window/size/window_width_override=405
window/size/window_height_override=878
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.047, 0.059, 0.051, 1)

[input_devices]

pointing/emulate_touch_from_mouse=true
