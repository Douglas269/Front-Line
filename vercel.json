{
  "rewrites": [
    {
      "source": "/",
      "destination": "/prototipo/ponto-alpha.html"
    },
    {
      "source": "/versao.json",
      "destination": "/prototipo/versao.json"
    },
    {
      "source": "/manifest.webmanifest",
      "destination": "/prototipo/manifest.webmanifest"
    },
    {
      "source": "/sw.js",
      "destination": "/prototipo/sw.js"
    },
    {
      "source": "/icons/:path*",
      "destination": "/prototipo/icons/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(versao.json|prototipo/versao.json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/prototipo/ponto-alpha.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(sw.js|prototipo/sw.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/(manifest.webmanifest|prototipo/manifest.webmanifest)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ]
}
